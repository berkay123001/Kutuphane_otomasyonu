# ---- Veritabanı ----
# Boş bırakırsan veriler yerelde ./.veri klasörüne yazılır (kurulum gerekmez).
# Supabase için: Project → Connect → "Session pooler" bağlantı adresini yapıştır
# (şifredeki özel karakterleri URL-encode etmeyi unutma).
DATABASE_URL=

# Supabase bağlantısı her zaman şifrelidir. Sunucu kimliğinin de doğrulanması için (önerilir):
# Supabase → Database Settings → SSL Configuration → sertifikayı indir, yolunu buraya yaz.
DATABASE_SSL_CA=

# ---- Güvenlik ----
# En az 32 karakter, rastgele olmalı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Frontend adresi (ör. http://localhost:5173). Boşsa her adrese izin verilir.
CORS_ORIGIN=

PORT=3000

# Render/Railway/nginx gibi bir proxy arkasında çalışıyorsan 1 yap (rate limit gerçek IP'yi görsün).
TRUST_PROXY=0

# ---- İlk kurulum (npm run db:seed) ----
# Seed'den sonra giriş yapıp POST /api/auth/sifre ile şifreyi değiştir ve buradan sil.
ILK_GOREVLI_KULLANICI=admin
ILK_GOREVLI_SIFRE=
